{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sspat.local/schemas/wiki-proposal-v1.json",
  "title": "SSPAT Markdown Wiki proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "docId", "baseByteHash", "evidenceSnapshotHash", "changeSummary", "proposedMarkdown", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "docId": { "type": "string", "pattern": "^wiki-[a-z0-9][a-z0-9-]{2,127}$" },
    "baseByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changeSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "proposedMarkdown": { "type": "string", "minLength": 1, "maxLength": 2097152 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "sentence", "references"],
        "properties": {
          "blockId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
          "sentence": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": { "enum": ["event", "source"] },
                "id": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      }
    }
  }
}
